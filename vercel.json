{
  "version": 2,
  "builds": [
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/deposit-app/(.+\\.(js|css|png|jpg|jpeg|gif|svg|ico|webp|avif|woff|woff2|ttf|eot))",
      "dest": "/deposit-app/$1"
    },
    {
      "src": "/deposit-app/(.*)",
      "dest": "/deposit-app/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
